# Copy to .env and fill real values.

# Groq API key for LiteLLM's openai/gpt-oss-20b model route.
GROQ_API_KEY=set-me

# OpenRouter API key for embeddings (LiteLLM alias embed-small) and optional eval judge.
OPENROUTER_API_KEY=set-me

# Qdrant sparse vector model used by ingestion and query.
SPARSE_MODEL=Qdrant/bm25

# LiteLLM gateway auth key (set a non-default value).
LITELLM_MASTER_KEY=set-me

# Postgres bootstrap
POSTGRES_DB=platform
POSTGRES_USER=app
POSTGRES_PASSWORD=set-me

# Dedicated Phase 2.2 ingestion role; do not reuse the Postgres bootstrap password.
POSTGRES_INGEST_PASSWORD=set-me

# Read-only Phase 2.3 API query role; do not reuse the bootstrap or ingestion password.
POSTGRES_QUERY_PASSWORD=set-me

# MinIO bootstrap
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=set-me

# API-level MinIO credentials
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=set-me

# Image tag for ai-api
AI_API_IMAGE=localhost/ai-api:stage3.9
